[Unit]
Description=Lain42 Agent headless companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lain42-agent
Group=lain42-agent
WorkingDirectory=/opt/lain42-agent-companion
EnvironmentFile=/etc/lain42-agent-companion.env
ExecStart=/opt/lain42-agent-companion/lain42-agent-companion
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.config/lain42

[Install]
WantedBy=multi-user.target
