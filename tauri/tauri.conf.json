{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lain42 Agent",
  "version": "0.1.0",
  "identifier": "top.lain42.agent",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "云枢智创 Agent 桌面工作台",
    "longDescription": "在 Windows、macOS 和 Linux 上快速使用云枢智创 Agent。",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/lain42-logo-192.png",
      "icons/lain42-logo-512.png"
    ]
  }
}
